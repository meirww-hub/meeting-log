<?xml version="1.0" encoding="utf-8"?>
<!--
  נגן ההקלטה שבתוך מסך הצ'אט: נפתח כשמקישים על זמן בתשובה או על שורת מקור,
  ומתחיל לנגן בדיוק מהרגע שצוטט.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/playPauseButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_record_button_idle"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/playPauseIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/player_play" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="שיחה עם דני" />

            <TextView
                android:id="@+id/playerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="מוריד את ההקלטה… 42%" />
        </LinearLayout>

        <ImageView
            android:id="@+id/playerClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_clear"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/player_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerSeekRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/playerPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="2:21" />

        <SeekBar
            android:id="@+id/playerSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="@color/accent_cyan"
            android:thumbTint="@color/accent_cyan"
            android:progressBackgroundTint="@color/surface_stroke" />

        <TextView
            android:id="@+id/playerDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="34:07" />
    </LinearLayout>

</LinearLayout>
