# פרויקט Google Cloud
GOOGLE_CLOUD_PROJECT=

# נתיב לקובץ JSON של Service Account - משמש רק ל-Firestore
# (לא ל-Drive - שם יש בעיית מכסת אחסון בחשבון Gmail אישי, ראו למטה)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# תיקיית שורש ב-Drive שבתוכה ייווצרו תיקיות ההקלטות (מזהה תיקייה מתוך ה-URL, לא שם)
DRIVE_ROOT_FOLDER_ID=

# פרטי OAuth ל-Drive בשם החשבון האישי - מופקים פעם אחת עם
# scripts/get_drive_oauth_token.py (ראו את הקובץ להוראות)
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=

# מפתח Gemini API (Google AI Studio - יש שכבה חינמית) לתמלול+diarization
# וגם לסיכום וחילוץ משימות
GEMINI_API_KEY=

# שפת תמלול ברירת מחדל (BCP-47)
TRANSCRIPTION_LANGUAGE=he-IL
